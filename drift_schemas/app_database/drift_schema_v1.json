  "fixed_sql": [
    {
      "name": "daily_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_logs\" (\"day\" TEXT NOT NULL CHECK(\"day\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), \"overall\" INTEGER NULL CHECK(\"overall\" BETWEEN 1 AND 5), \"pain\" INTEGER NULL CHECK(\"pain\" BETWEEN 1 AND 5), \"fatigue\" INTEGER NULL CHECK(\"fatigue\" BETWEEN 1 AND 5), \"sleep\" INTEGER NULL CHECK(\"sleep\" BETWEEN 1 AND 5), \"appetite\" INTEGER NULL CHECK(\"appetite\" BETWEEN 1 AND 5), \"mood\" INTEGER NULL CHECK(\"mood\" BETWEEN 1 AND 5), \"memo\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "avoidances",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"avoidances\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"in_use\" INTEGER NOT NULL DEFAULT 1 CHECK (\"in_use\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "avoidance_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"avoidance_checks\" (\"day\" TEXT NOT NULL CHECK(\"day\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'), \"avoidance_id\" INTEGER NOT NULL REFERENCES avoidances (id), PRIMARY KEY (\"day\", \"avoidance_id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
